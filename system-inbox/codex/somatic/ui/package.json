{
  "name": "somatic-ui",
  "private": true,
  "version": "0.2.0",
  "description": "Authoring package for Somatic local UI. Production users run python -m somatic ui (Vite-built static assets + stdlib bridge). Node is not a Python dependency.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-shell.mjs",
    "preview": "vite preview --port 3000",
    "a11y": "node scripts/a11y-check.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@theatre/core": "^0.7.2",
    "@xterm/xterm": "^5.5.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "lil-gui": "^0.20.0",
    "maath": "^0.10.8",
    "postprocessing": "^6.37.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.182.0",
    "troika-three-text": "^0.52.4",
    "yocto-spinner": "^1.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
