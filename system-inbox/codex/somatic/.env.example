SOMATIC_OFFLINE=1
SOMATIC_RUNS_DIR=runs
SOMATIC_ADVANCED_LANES_ENABLED=0

# Optional live literature (OFF unless set to 1/true/yes/on).
# Public APIs only (Europe PMC). Never sends sensor data. CI stays offline.
# SOMATIC_RESEARCH_LIVE=0

# Optional encryption at rest for local stores (OFF unless set to 1/true/on/yes).
# Requires the optional `cryptography` package (e.g. pip install "somatic[fabric]").
# Default stays plaintext + 0600. See SECURITY.md.
# SOMATIC_ENCRYPT_STORES=0
# SOMATIC_STORE_PASSPHRASE=

# Phase 1C does not require provider secrets.

# Multiverse fabric federation connector.
# Tokens, DID private keys, and sidecar secrets must stay in local secret/config storage.
SOMATIC_FABRIC_SIDECAR_URL=http://127.0.0.1:37877
SOMATIC_FABRIC_SIDECAR_TOKEN=
SOMATIC_FABRIC_REGISTRY_URL=
SOMATIC_FABRIC_REGISTRY_TOKEN=
SOMATIC_FABRIC_DID=
SOMATIC_FABRIC_SYSTEM_ID=somatic
SOMATIC_FABRIC_SYSTEM_NAME=Somatic
SOMATIC_FABRIC_REACHABILITY_URL=
SOMATIC_FABRIC_ALLOWLIST_DIDS=
SOMATIC_FABRIC_REGISTRY_REGISTER_PATH=/systems/register
SOMATIC_FABRIC_REGISTRY_ALLOWLIST_PATH=/fabric/federation/allowlist
SOMATIC_FABRIC_REGISTRY_DELIVERY_PATH=/fabric/federation/deliveries
SOMATIC_FABRIC_REGISTRY_INBOX_PATH=/fabric/federation/inbox
