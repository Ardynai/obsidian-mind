<mxfile host="app.diagrams.net" type="device">
  <diagram id="somatic-data-flow-gates" name="Somatic data flow and safety gates">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
