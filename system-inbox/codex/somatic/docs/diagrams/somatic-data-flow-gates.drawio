        <mxCell id="response" value="Response&#xa;framed · features only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12261E;strokeColor=#35E7A6;fontFamily=IBM Plex Sans;fontSize=13;fontColor=#35E7A6" vertex="1" parent="1">
          <mxGeometry x="910" y="188" width="164" height="88" as="geometry"/>
