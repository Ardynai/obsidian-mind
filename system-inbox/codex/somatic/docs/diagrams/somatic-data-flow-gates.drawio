        <mxCell id="title" value="FIGURE 2 — DATA FLOW &amp; SAFETY GATES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=IBM Plex Mono;fontSize=13;fontColor=#35E7A6" vertex="1" parent="1">
          <mxGeometry x="48" y="24" width="720" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Every request runs the same gates. Consent, emergency, framing, citation-binding, and biosecurity are on the path." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=IBM Plex Sans;fontSize=16;fontColor=#EAF5EF;fontStyle=1" vertex="1" parent="1">
